{
  // Default formatter - Prettier for all supported file types
  "editor.defaultFormatter": "esbenp.prettier-vscode",

  // Format on save
  "editor.formatOnSave": true,

  // Code actions on save - ESLint fixes (runs after Prettier formatting)
  "editor.codeActionsOnSave": { "source.fixAll.eslint": "explicit" },

  // Prettier configuration
  "prettier.requireConfig": true,

  // Language-specific formatter settings
  "[javascript]": { "editor.defaultFormatter": "esbenp.prettier-vscode" },
  "[javascriptreact]": { "editor.defaultFormatter": "esbenp.prettier-vscode" },
  "[json]": { "editor.defaultFormatter": "esbenp.prettier-vscode" },
  "[jsonc]": { "editor.defaultFormatter": "esbenp.prettier-vscode" },
  "[markdown]": { "editor.defaultFormatter": "esbenp.prettier-vscode", "editor.wordWrap": "on" },
  "[yaml,yml]": { "editor.defaultFormatter": "esbenp.prettier-vscode" },
  "[css]": { "editor.defaultFormatter": "esbenp.prettier-vscode" },
  "[html]": { "editor.defaultFormatter": "esbenp.prettier-vscode" },

  // Disable VS Code's built-in JavaScript/TypeScript formatters to prevent conflicts
  "javascript.format.enable": false,
  "typescript.format.enable": false,

  // Ignore TanStack router generated files
  "files.readonlyInclude": { "**/routeTree.gen.ts": true },
  "files.watcherExclude": { "**/routeTree.gen.ts": true },
  "search.exclude": {
    "**/routeTree.gen.ts": true
  },

  "files.associations": { "**/apps/client/src/**/*.css": "tailwindcss" },

  "typescript.tsdk": "node_modules/typescript/lib"
}
