# === server
NODE_ENV=production
PORT=5001
CLIENT_URL=https://sandwicheck.app
# === database
MONGO_URI=
# === file uploads
MAX_UPLOAD_SIZE_IN_BYTES=10485760 # 10MB
USER_IMAGE_WIDTHH=480
USER_IMAGE_HEIGHT=480
PROFILE_IMAGE_EXTENSION=jpeg
INGREDIENTS_IMAGE_EXTENSION=png
SANDWICH_UPDATE_EXPIRES_IN_MINS=15
SANDWICHES_PER_PAGE_DEFAULT=48 # divisible by 2, 3, and 4
# === security
JWT_SECRET=
JWT_EXPIRES_IN=90d
JWT_COOKIE_EXPIRE_IN_DAYS=90
BCRYPT_SALT_ROUNDS=10
RESET_PASSWORD_EXPIRES_IN=1200000 # 20 minutes
# === mail
# For LOCAL DEVELOPMENT with Mailpit:
# - Start Mailpit: docker-compose up -d mailpit
# - Web UI: http://localhost:8025
# - SMTP: localhost:1025 (no auth required)
# MAIL_HOST=localhost
# MAIL_PORT=1025
# MAIL_USERNAME=  # Leave empty for Mailpit
# MAIL_PASSWORD=  # Leave empty for Mailpit
# EMAIL_FROM=test@example.com

# For PRODUCTION with Resend.com:
# - Get API key from https://resend.com
# - Verify your domain in Resend dashboard
EMAIL_FROM='Sandwicheck <no-reply@sandwicheck.app>'
MAIL_HOST=smtp.resend.com
MAIL_PORT=465
MAIL_USERNAME=resend
MAIL_PASSWORD=  # Your Resend API key (starts with re_)

# === email confirmation
EMAIL_CONFIRMATION_EXPIRES_I=86400000  # 24 hours in milliseconds
EMAIL_CONFIRMATION_RESEND_COOLDOWN_MS=900000  # 15 minutes in milliseconds
