{
  "name": "@sandwicheck/server",
  "version": "1.0.0",
  "description": "SandwiCheck server application",
  "main": "./server.js",
  "type": "module",
  "author": "Moshe Bukhman",
  "license": "CC BY-NC-ND 4.0",
  "scripts": {
    "start": "NODE_ENV=production node server.js",
    "dev": "NODE_ENV=local node --env-file ./config/.env --watch server.js",
    "dev:staging": "NODE_ENV=development node --env-file ./config/.env --watch server.js",
    "init-db": "node --env-file ./config/.env service/initDatabase.js",
    "lint": "eslint",
    "lint:fix": "eslint --fix",
    "init-uploads": "node --env-file ./config/.env service/initUploadsFolder.js",
    "migrate-email-confirmation-fields": "node --env-file ./config/.env service/migrateEmailConfirmationFields.js"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "express": "^5.1.0",
    "express-async-handler": "^1.2.0",
    "express-rate-limit": "^8.2.1",
    "express-xss-sanitizer": "^2.0.1",
    "helmet": "^8.1.0",
    "hpp": "^0.2.3",
    "http-errors": "^2.0.1",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^9.0.0",
    "morgan": "^1.10.1",
    "multer": "^2.0.2",
    "nodemailer": "^7.0.11",
    "sharp": "^0.34.5",
    "winston": "^3.18.3",
    "@sandwicheck/shared-utils": "workspace:*"
  },
  "devDependencies": {
    "@types/nodemailer": "^7.0.4",
    "globals": "^16.5.0"
  }
}
