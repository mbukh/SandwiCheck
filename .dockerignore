# Dependencies
node_modules
**/node_modules

# Build outputs
**/build
**/dist
**/.next
**/out

# Environment files (dockerignore patterns are root-anchored: "*" does not
# cross "/", so the leading "**/" is required to exclude nested env files)
**/*.env*
!**/*.env.example

# Git
.git
.gitignore
.gitattributes

# IDE
.vscode
.idea
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Testing
coverage
.nyc_output
**/__tests__
**/__test__
**/__mocks__
**/*.test.js
**/*.test.jsx
**/*.test.ts
**/*.test.tsx
**/*.spec.js
**/*.spec.jsx
**/*.spec.ts
**/*.spec.tsx
**/vitest.config.ts

# Documentation
README.md
*.md
docs/

# CI/CD
.github
.gitlab-ci.yml
.travis.yml

# Docker
docker-compose*.yml
Dockerfile*
.dockerignore

# Data and uploads (keep structure but not content)
data/
**/uploads/*
!**/uploads/.gitkeep

# Misc
.cache
*.pem
*.key
*.cert
