{
  "name": "sandwicheck-fullstack",
  "version": "1.0.0",
  "description": "a sandwich maker app for the whole family",
  "type": "module",
  "private": true,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mbukh/Appleseeds-SandwiCheck.git"
  },
  "keywords": [
    "sandwich",
    "family"
  ],
  "author": "Moshe Bukhman",
  "license": "CC BY-NC-ND 4.0",
  "bugs": {
    "url": "https://github.com/mbukh/Appleseeds-SandwiCheck/issues"
  },
  "homepage": "https://github.com/mbukh/Appleseeds-SandwiCheck#readme",
  "scripts": {
    "server": "pnpm --filter @sandwicheck/server dev",
    "client": "pnpm --filter @sandwicheck/client start --host",
    "dev": "pnpm run \"/server|client/\"",
    "init-db": "pnpm --filter @sandwicheck/server init-db",
    "lint:root": "eslint .",
    "lint:root:fix": "eslint . --fix",
    "lint": "pnpm lint:root && pnpm --recursive lint",
    "lint:fix": "pnpm lint:root:fix && pnpm --recursive lint:fix",
    "format": "prettier --check .",
    "format:fix": "prettier --write .",
    "knip": "knip",
    "update:all": "corepack use pnpm@latest && pnpm up --recursive",
    "update:all:latest": "corepack use pnpm@latest &&pnpm up --latest --recursive --interactive",
    "prepare": "husky"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@eslint/json": "^1.2.0",
    "@eslint/markdown": "^7.5.1",
    "@types/node": "^25.9.1",
    "concurrently": "^9.2.1",
    "eslint": "^10.4.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-simple-import-sort": "^12.1.1",
    "eslint-plugin-unicorn": "63.0.0",
    "eslint-plugin-unused-imports": "^4.4.1",
    "eslint-plugin-yml": "^3.3.2",
    "globals": "^17.6.0",
    "husky": "^9.1.7",
    "knip": "^5.88.1",
    "lint-staged": "^16.4.0",
    "prettier": "^3.8.3",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.60.0"
  },
  "packageManager": "pnpm@11.4.0+sha512.f0febc7e37552ab485494a914241b338e0b3580b93d54ce31f00933015880863129038a1b4ae4e414a0ee63ac35bf21197e990172c4a68256450b5636310968f"
}
