{
  "name": "sandwicheck-fullstack",
  "version": "1.0.0",
  "description": "a sandwich maker app for the whole family",
  "type": "module",
  "private": true,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mbukh/Appleseeds-SandwiCheck.git"
  },
  "keywords": [
    "sandwich",
    "family"
  ],
  "author": "Moshe Bukhman",
  "license": "CC BY-NC-ND 4.0",
  "bugs": {
    "url": "https://github.com/mbukh/Appleseeds-SandwiCheck/issues"
  },
  "homepage": "https://github.com/mbukh/Appleseeds-SandwiCheck#readme",
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=11.0.0"
  },
  "scripts": {
    "server": "pnpm --filter @sandwicheck/server dev",
    "client": "pnpm --filter @sandwicheck/client start --host",
    "dev": "pnpm run \"/server|client/\"",
    "init-db": "pnpm --filter @sandwicheck/server init-db",
    "lint:root": "eslint .",
    "lint:root:fix": "eslint . --fix",
    "lint": "pnpm lint:root && pnpm --recursive --parallel lint",
    "lint:fix": "pnpm lint:root:fix && pnpm --recursive --parallel lint:fix",
    "typecheck": "pnpm --recursive --parallel typecheck",
    "format": "prettier --check .",
    "format:fix": "prettier --write .",
    "knip": "knip",
    "update:all": "corepack use pnpm@latest && pnpm up --recursive",
    "update:all:latest": "corepack use pnpm@latest && pnpm up --latest --recursive --interactive",
    "prepare": "husky"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@eslint/json": "^1.2.0",
    "@eslint/markdown": "^7.5.1",
    "@types/node": "^25.9.1",
    "concurrently": "^9.2.1",
    "eslint": "catalog:",
    "eslint-config-prettier": "catalog:",
    "eslint-import-resolver-typescript": "^4.4.4",
    "eslint-plugin-import": "catalog:",
    "eslint-plugin-simple-import-sort": "catalog:",
    "eslint-plugin-unicorn": "catalog:",
    "eslint-plugin-unused-imports": "catalog:",
    "eslint-plugin-yml": "^3.4.0",
    "globals": "catalog:",
    "husky": "^9.1.7",
    "knip": "^5.88.1",
    "lint-staged": "^16.4.0",
    "prettier": "catalog:",
    "typescript": "catalog:",
    "typescript-eslint": "catalog:"
  },
  "packageManager": "pnpm@11.5.0+sha512.dbfcc4f81cf48597afd4bc391ffdf12c11f1a9fb83a395bfa6b0a2d9cc2fd8ffebafdb1ccbd529632153f793904c2615b7f09fe1a345473fd1c35845172a8eb1"
}
