{
  "name": "sandwicheck-fullstack",
  "version": "1.0.0",
  "description": "a sandwich maker app for the whole family",
  "type": "module",
  "private": true,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mbukh/Appleseeds-SandwiCheck.git"
  },
  "keywords": [
    "sandwich",
    "family"
  ],
  "author": "Moshe Bukhman",
  "license": "CC BY-NC-ND 4.0",
  "bugs": {
    "url": "https://github.com/mbukh/Appleseeds-SandwiCheck/issues"
  },
  "homepage": "https://github.com/mbukh/Appleseeds-SandwiCheck#readme",
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "start": "pnpm --filter @sandwicheck/server start",
    "server": "pnpm --filter @sandwicheck/server dev",
    "client": "pnpm --filter @sandwicheck/client start",
    "dev": "concurrently \"pnpm run server\" \"pnpm run client\"",
    "init-db": "pnpm --filter @sandwicheck/server init-db",
    "lint": "pnpm lint:root && pnpm --filter @sandwicheck/client lint && pnpm --filter @sandwicheck/server lint",
    "lint:fix": "pnpm lint:root:fix && pnpm --filter @sandwicheck/client lint:fix && pnpm --filter @sandwicheck/server lint:fix",
    "lint:root": "eslint .",
    "lint:root:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "knip": "knip"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@eslint/json": "^0.14.0",
    "@eslint/markdown": "^7.5.1",
    "@types/node": "^24.10.1",
    "concurrently": "^9.2.1",
    "eslint": "^9.39.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-unicorn": "62.0.0",
    "eslint-plugin-yml": "^1.19.0",
    "globals": "^16.5.0",
    "knip": "^5.70.1",
    "prettier": "^3.6.2",
    "typescript": "^5.9.3"
  },
  "pnpm": {
    "overrides": {
      "vite": "npm:rolldown-vite@7.2.5"
    }
  },
  "packageManager": "pnpm@10.22.0"
}