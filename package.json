{
  "name": "sandwicheck-fullstack",
  "version": "1.0.0",
  "description": "a sandwich maker app for the whole family",
  "type": "module",
  "private": true,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mbukh/Appleseeds-SandwiCheck.git"
  },
  "keywords": [
    "sandwich",
    "family"
  ],
  "author": "Moshe Bukhman",
  "license": "CC BY-NC-ND 4.0",
  "bugs": {
    "url": "https://github.com/mbukh/Appleseeds-SandwiCheck/issues"
  },
  "homepage": "https://github.com/mbukh/Appleseeds-SandwiCheck#readme",
  "scripts": {
    "server": "pnpm --filter @sandwicheck/server dev",
    "client": "pnpm --filter @sandwicheck/client start",
    "dev": "concurrently \"pnpm run server\" \"pnpm run client\"",
    "init-db": "pnpm --filter @sandwicheck/server init-db",
    "lint:root": "eslint .",
    "lint:root:fix": "eslint . --fix",
    "lint": "pnpm lint:root && pnpm --recursive lint",
    "lint:fix": "pnpm lint:root:fix && pnpm --recursive lint:fix",
    "format": "prettier --check .",
    "format:fix": "prettier --write .",
    "knip": "knip",
    "update:all": "corepack use pnpm@latest && pnpm up --recursive",
    "update:all:latest": "corepack use pnpm@latest &&pnpm up --latest --recursive",
    "prepare": "husky"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@eslint/json": "^0.14.0",
    "@eslint/markdown": "^7.5.1",
    "@types/node": "^24.10.1",
    "concurrently": "^9.2.1",
    "eslint": "^9.39.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-simple-import-sort": "^12.1.1",
    "eslint-plugin-unicorn": "62.0.0",
    "eslint-plugin-unused-imports": "^4.3.0",
    "eslint-plugin-yml": "^1.19.0",
    "globals": "^16.5.0",
    "husky": "^9.1.7",
    "knip": "^5.70.2",
    "lint-staged": "^16.2.7",
    "prettier": "^3.7.3",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.48.0"
  },
  "pnpm": {
    "overrides": {
      "vite": "npm:rolldown-vite@7.2.5"
    }
  },
  "packageManager": "pnpm@10.24.0+sha512.01ff8ae71b4419903b65c60fb2dc9d34cf8bb6e06d03bde112ef38f7a34d6904c424ba66bea5cdcf12890230bf39f9580473140ed9c946fef328b6e5238a345a"
}
